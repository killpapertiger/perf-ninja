  __m128 v_zeros = _mm_setzero_ps();
  for (std::size_t i = 0; i + 4 < length; i += 4) {
    __m128 v_v = _mm_load_ps(v + i);
    __m128 ge_mask = _mm_cmpge_ps(v_v, v_zeros);
